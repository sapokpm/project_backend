@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false

entity users {
  * id : BIGINT <<PK>>
  --
  * email : VARCHAR(255)
  * password : VARCHAR(100)
  * first_name : VARCHAR(100)
  * last_name : VARCHAR(100)
   phone : VARCHAR(32)
  * role : VARCHAR(20)
  * enabled : BOOLEAN
  * email_verified : BOOLEAN
   last_login_at : TIMESTAMP
  * created_at : TIMESTAMP
   updated_at : TIMESTAMP
}

entity addresses {
  * id : BIGINT <<PK>>
  --
   title : VARCHAR(100)
  * country : VARCHAR(100)
  * city : VARCHAR(100)
  * street : VARCHAR(200)
   building : VARCHAR(50)
   apartment : VARCHAR(50)
   postal_code : VARCHAR(20)
  * recipient_name : VARCHAR(200)
  * recipient_phone : VARCHAR(32)
  * is_default : BOOLEAN
   latitude : NUMERIC(9,6)
   longitude : NUMERIC(9,6)
  * user_id : BIGINT <<FK>>
}

entity brands {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * slug : VARCHAR(120)
   description : TEXT
   logo_url : VARCHAR(500)
   website_url : VARCHAR(500)
   country : VARCHAR(100)
  * is_active : BOOLEAN
}

entity categories {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * slug : VARCHAR(120)
   description : TEXT
   image_url : VARCHAR(500)
  * sort_order : INTEGER
  * is_active : BOOLEAN
   parent_id : BIGINT <<FK>>
}

entity products {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(200)
  * slug : VARCHAR(220)
   description : TEXT
   short_description : VARCHAR(500)
  * sku : VARCHAR(64)
  * base_price : NUMERIC(12,2)
   discount_price : NUMERIC(12,2)
   discount_start_date : TIMESTAMP
   discount_end_date : TIMESTAMP
  * stock_quantity : INTEGER
  * reserved_quantity : INTEGER
  * low_stock_threshold : INTEGER
   weight : NUMERIC(8,3)
   dimensions : VARCHAR(100)
  * is_active : BOOLEAN
  * is_featured : BOOLEAN
  * is_new_arrival : BOOLEAN
  * average_rating : NUMERIC(3,2)
  * review_count : INTEGER
  * view_count : BIGINT
  * sales_count : BIGINT
   meta_title : VARCHAR(200)
   meta_description : VARCHAR(500)
  * category_id : BIGINT <<FK>>
   brand_id : BIGINT <<FK>>
  * created_at : TIMESTAMP
   updated_at : TIMESTAMP
}

entity product_variants {
  * id : BIGINT <<PK>>
  --
  * sku : VARCHAR(64)
  * name : VARCHAR(200)
   attributes : JSONB
  * price : NUMERIC(12,2)
  * stock_quantity : INTEGER
  * reserved_quantity : INTEGER
   image_url : VARCHAR(500)
  * is_active : BOOLEAN
  * product_id : BIGINT <<FK>>
}

entity product_images {
  * id : BIGINT <<PK>>
  --
  * image_url : VARCHAR(500)
   thumbnail_url : VARCHAR(500)
   alt_text : VARCHAR(200)
  * is_primary : BOOLEAN
  * sort_order : INTEGER
  * product_id : BIGINT <<FK>>
}

entity product_specifications {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * value : VARCHAR(500)
   group_name : VARCHAR(100)
  * sort_order : INTEGER
  * product_id : BIGINT <<FK>>
}

entity reviews {
  * id : BIGINT <<PK>>
  --
  * rating : INTEGER
   title : VARCHAR(200)
   comment : TEXT
   pros : TEXT
   cons : TEXT
   images : JSONB
  * is_verified_purchase : BOOLEAN
  * helpful_count : INTEGER
  * not_helpful_count : INTEGER
   admin_reply : TEXT
   admin_reply_at : TIMESTAMP
  * status : VARCHAR(20)
  * product_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
  * created_at : TIMESTAMP
   updated_at : TIMESTAMP
}

entity carts {
  * id : BIGINT <<PK>>
  --
   session_id : VARCHAR(100)
   applied_promo_code : VARCHAR(50)
   user_id : BIGINT <<FK>>
  * created_at : TIMESTAMP
   updated_at : TIMESTAMP
}

entity cart_items {
  * id : BIGINT <<PK>>
  --
  * quantity : INTEGER
  * price_at_add : NUMERIC(12,2)
  * cart_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
   variant_id : BIGINT <<FK>>
}

entity wishlists {
  * id : BIGINT <<PK>>
  --
  * price_at_add : NUMERIC(12,2)
  * notify_on_price_drop : BOOLEAN
  * notify_on_back_in_stock : BOOLEAN
  * user_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  * added_at : TIMESTAMP
}

entity delivery_options {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * code : VARCHAR(32)
   description : VARCHAR(500)
  * base_price : NUMERIC(12,2)
   free_threshold : NUMERIC(12,2)
  * estimated_days_min : INTEGER
  * estimated_days_max : INTEGER
  * is_active : BOOLEAN
}

entity orders {
  * id : BIGINT <<PK>>
  --
  * order_number : VARCHAR(32)
  * status : VARCHAR(20)
   shipping_country : VARCHAR(100)
   shipping_city : VARCHAR(100)
   shipping_street : VARCHAR(200)
   shipping_building : VARCHAR(50)
   shipping_apartment : VARCHAR(50)
   shipping_postal_code : VARCHAR(20)
   shipping_recipient_name : VARCHAR(200)
   shipping_recipient_phone : VARCHAR(32)
  * delivery_method : VARCHAR(20)
   delivery_tracking_number : VARCHAR(100)
   estimated_delivery_date : DATE
   actual_delivery_date : DATE
  * subtotal : NUMERIC(12,2)
  * shipping_cost : NUMERIC(12,2)
  * discount : NUMERIC(12,2)
  * bonus_points_used : INTEGER
  * bonus_points_earned : INTEGER
  * total_amount : NUMERIC(12,2)
   promo_code : VARCHAR(50)
   customer_note : TEXT
   admin_note : TEXT
  * user_id : BIGINT <<FK>>
  * created_at : TIMESTAMP
   updated_at : TIMESTAMP
   paid_at : TIMESTAMP
   shipped_at : TIMESTAMP
   delivered_at : TIMESTAMP
}

entity order_items {
  * id : BIGINT <<PK>>
  --
  * quantity : INTEGER
  * price_at_purchase : NUMERIC(12,2)
   product_snapshot : JSONB
  * order_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
   variant_id : BIGINT <<FK>>
}

entity payments {
  * id : BIGINT <<PK>>
  --
   transaction_id : VARCHAR(100)
  * payment_method : VARCHAR(20)
  * status : VARCHAR(24)
  * amount : NUMERIC(12,2)
  * currency : VARCHAR(3)
  * bonus_points_used : INTEGER
   card_last_four_digits : VARCHAR(4)
   paid_at : TIMESTAMP
   error_message : VARCHAR(500)
   error_code : VARCHAR(50)
  * refunded_amount : NUMERIC(12,2)
   metadata : JSONB
  * order_id : BIGINT <<FK>>
}

entity promo_codes {
  * id : BIGINT <<PK>>
  --
  * code : VARCHAR(50)
   description : VARCHAR(500)
  * discount_type : VARCHAR(20)
  * discount_value : NUMERIC(12,2)
   min_order_amount : NUMERIC(12,2)
   max_discount_amount : NUMERIC(12,2)
   max_usage_count : INTEGER
  * current_usage_count : INTEGER
   max_usage_per_user : INTEGER
   valid_from : TIMESTAMP
   valid_to : TIMESTAMP
  * is_active : BOOLEAN
   created_by : BIGINT <<FK>>
}

entity promo_code_categories {
  * promo_code_id : BIGINT <<PK>>
  * category_id : BIGINT <<PK>>
  --
}

entity promo_code_products {
  * promo_code_id : BIGINT <<PK>>
  * product_id : BIGINT <<PK>>
  --
}

entity promo_code_usages {
  * id : BIGINT <<PK>>
  --
  * discount_applied : NUMERIC(12,2)
  * promo_code_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
  * order_id : BIGINT <<FK>>
  * used_at : TIMESTAMP
}

entity refresh_tokens {
  * id : BIGINT <<PK>>
  --
  * token : VARCHAR(500)
  * expiry_date : TIMESTAMP
  * revoked : BOOLEAN
  * user_id : BIGINT <<FK>>
  * created_at : TIMESTAMP
}

users ||--o{ addresses : user_id
categories ||--o{ categories : parent_id
categories ||--o{ products : category_id
brands ||--o{ products : brand_id
products ||--o{ product_variants : product_id
products ||--o{ product_images : product_id
products ||--o{ product_specifications : product_id
products ||--o{ reviews : product_id
users ||--o{ reviews : user_id
users ||--o{ carts : user_id
carts ||--o{ cart_items : cart_id
products ||--o{ cart_items : product_id
product_variants ||--o{ cart_items : variant_id
users ||--o{ wishlists : user_id
products ||--o{ wishlists : product_id
users ||--o{ orders : user_id
orders ||--o{ order_items : order_id
products ||--o{ order_items : product_id
product_variants ||--o{ order_items : variant_id
orders ||--o{ payments : order_id
users ||--o{ promo_codes : created_by
promo_codes ||--o{ promo_code_categories : promo_code_id
categories ||--o{ promo_code_categories : category_id
promo_codes ||--o{ promo_code_products : promo_code_id
products ||--o{ promo_code_products : product_id
promo_codes ||--o{ promo_code_usages : promo_code_id
users ||--o{ promo_code_usages : user_id
orders ||--o{ promo_code_usages : order_id
users ||--o{ refresh_tokens : user_id
@enduml
